# ============================================================
#  DevCore Solutions - Docker Hacking Lab
#  Valores de ejemplo. TODOS los valores son FICTICIOS.
#  Copia este archivo a .env si quieres personalizar el laboratorio.
#  (docker compose funciona sin .env: usa los valores por defecto)
# ============================================================

# Puerto del host donde se publica la maquina (http://localhost:8080)
LAB_HOST_PORT=8080

# Interfaz de escucha. Por defecto solo loopback (127.0.0.1) para no exponer
# el laboratorio en la red local. Para acceder desde otro equipo: LAB_BIND_ADDRESS=0.0.0.0
LAB_BIND_ADDRESS=127.0.0.1

# --- Base de datos (ficticia) ---
POSTGRES_USER=devcore
POSTGRES_PASSWORD=devcore_ficticio_2024
POSTGRES_DB=devcore
DATABASE_URL=postgresql://devcore:devcore_ficticio_2024@db:5432/devcore

# --- API ---
DEVCORE_BUILD_TOKEN=dc-api-2024.11-rc2
FLAGS_SERVICE_URL=http://flags:8000

# --- Web ---
APP_SECRET=devcore-fictitious-app-secret
