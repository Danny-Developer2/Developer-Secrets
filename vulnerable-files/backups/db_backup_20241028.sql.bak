CREATE TABLE users (
    id         SERIAL PRIMARY KEY,
    username   VARCHAR(50) UNIQUE NOT NULL,
    full_name  VARCHAR(120),
    email      VARCHAR(120),
    role       VARCHAR(40),
    department VARCHAR(60)
);

